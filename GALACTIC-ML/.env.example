# Use ONE fresh key for all 4 modules (old G1 hardcoded key was revoked: 403 leaked)
# Get key: https://aistudio.google.com/

GEMMA_API_KEY=AIza_your_fresh_key_here
GEMMA_MODEL=gemma-4-26b-a4b-it

# --- API-supported only (https://ai.google.dev/gemma/docs/core/gemma_on_gemini_api) ---
# GEMMA_MODEL=gemma-4-26b-a4b-it   # MoE, efficient (default, recommended)
# GEMMA_MODEL=gemma-4-31b-it       # dense, max quality
# DO NOT USE gemma-4-12b-it on Gemini API (404 — HF/local-only)

# --- Backwards compat + Vite (G1 needs VITE_ prefix for import.meta.env) ---
# Copy same fresh key/model into VITE_ vars:
VITE_GEMMA_API_KEY=AIza_your_fresh_key_here
VITE_GEMMA_MODEL=gemma-4-26b-a4b-it
VITE_GEMINI_API_KEY=AIza_your_fresh_key_here
GEMINI_API_KEY=AIza_your_fresh_key_here
GEMINI_MODEL=gemma-4-26b-a4b-it

# --- G1 Supabase (only for Notebook Forge history) ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
