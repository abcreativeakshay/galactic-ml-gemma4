# Use ONE key for all 4 Galactic ML modules (Gemma 4 via Gemini API)
# Get key: https://aistudio.google.com/ (same key works for Gemma + Gemini)

GEMMA_API_KEY=AIza_your_key_here
GEMMA_MODEL=gemma-4-12b-it

# --- Alternatives (uncomment to switch, no code change) ---
# GEMMA_MODEL=gemma-4-31b-it       # dense, max quality
# GEMMA_MODEL=gemma-4-26b-a4b-it   # MoE, efficient reasoning, great for 100-Q
# GEMMA_MODEL=gemma-4-12b-it       # balanced (default)
# GEMMA_MODEL=gemma-4-e4b-it       # edge / fast

# --- Backwards compat + Vite (G1 needs VITE_ prefix for import.meta.env) ---
# Copy same key/model into VITE_ vars:
VITE_GEMMA_API_KEY=AIza_your_key_here
VITE_GEMMA_MODEL=gemma-4-12b-it
VITE_GEMINI_API_KEY=AIza_your_key_here
GEMINI_API_KEY=AIza_your_key_here
GEMINI_MODEL=gemma-4-12b-it

# --- G1 Supabase (only for Notebook Forge history) ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
